  difficultyEntries:
  - difficultyType: 0
    entries:
    - entryId: equip_1
      weight: 1
      nodes:
      - nodeId: start
        textTemplate: "\uADF8 {toolGrade} \uB4F1\uAE09 \uC7A5\uBE44\uB85C \uC5EC\uAE30\uAE4C\uC9C0
          \uC628 \uAC83\uB3C4 \uB300\uB2E8\uD558\uB124. \uC880 \uB354 \uB098\uC740
          \uC7A5\uBE44\uAC00 \uD544\uC694\uD574 \uBCF4\uC774\uB294\uB370?"
        choices:
        - choiceText: "\uC7A5\uBE44\uB294 \uC5B4\uB514\uC11C \uAD6C\uD574?"
          nextNodeId: shop_hint
        - choiceText: "\uAD1C\uCC2E\uC544, \uC54C\uC544\uC11C \uD560\uAC8C"
          nextNodeId: 
      - nodeId: shop_hint
        textTemplate: "\uB300\uC7A5\uAC04\uC774\uB098 \uC0C1\uC810\uC744 \uB4E4\uB7EC\uBD10.
          \uC9C0\uAE08 \uC7A5\uBE44\uB85C\uB294 \uC55E\uC73C\uB85C \uB354 \uD798\uB4E4\uC5B4\uC9C8
          \uAC70\uC57C."
        choices: []
    - entryId: equip_2
      weight: 1
      nodes:
      - nodeId: start
        textTemplate: "\uC0AC\uB9DD\uC744 {deathCount}\uBC88\uC774\uB098 \uD588\uB2E4\uACE0?
          \uC7A5\uBE44\uBD80\uD130 \uC810\uAC80\uD574\uBCF4\uB294 \uAC8C \uC5B4\uB54C."
        choices:
        - choiceText: "\uC5B4\uB5A4 \uC7A5\uBE44\uAC00 \uC88B\uC544?"
          nextNodeId: advice
        - choiceText: "\uBAAC\uC2A4\uD130\uAC00 \uB108\uBB34 \uAC15\uD574\uC11C \uADF8\uB798"
          nextNodeId: denial
      - nodeId: advice
        textTemplate: "\uB4F1\uAE09\uC774 \uB192\uC740 \uBB34\uAE30/\uBC29\uC5B4\uAD6C\uC77C\uC218\uB85D
          \uC0DD\uC874\uC5D0 \uD070 \uB3C4\uC6C0\uC774 \uB3FC. \uC870\uAE08\uB9CC
          \uB354 \uBAA8\uC544\uBD10."
        choices: []
      - nodeId: denial
        textTemplate: "\uADF8\uB7F4 \uC218\uB3C4 \uC788\uC9C0\uB9CC, \uC7A5\uBE44
          \uB4F1\uAE09\uB3C4 \uD55C \uBC88 \uD655\uC778\uD574\uBCF4\uBA74 \uC88B\uC744
          \uAC70\uC57C."
        choices: []
  - difficultyType: 1
    entries:
    - entryId: combat_1
      weight: 1
      nodes:
      - nodeId: start
        textTemplate: "\uCD5C\uADFC\uC5D0 \uC790\uC8FC \uC4F0\uB7EC\uC9C0\uB358\uB370,
          \uC804\uD22C \uBC29\uC2DD\uC744 \uC880 \uBC14\uAFD4\uBCF4\uB294 \uAC74
