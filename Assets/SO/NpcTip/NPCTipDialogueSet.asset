        - choiceText: "\uC5B4\uB5BB\uAC8C \uC2F8\uC6CC\uC57C \uD574?"
          nextNodeId: tips
        - choiceText: "\uADF8\uB0E5 \uC6B4\uC774 \uB098\uBE74\uC5B4"
          nextNodeId: 
      - nodeId: tips
        textTemplate: "\uBB34\uC791\uC815 \uB364\uBE44\uC9C0 \uB9D0\uACE0, \uBAAC\uC2A4\uD130
          \uD328\uD134\uC744 \uBCF4\uACE0 \uD53C\uD558\uB294 \uD0C0\uC774\uBC0D\uC744
          \uC7A1\uC544\uBD10."
        choices: []
    - entryId: combat_2
      weight: 1
      nodes:
      - nodeId: start
        textTemplate: "{deathCount}\uBC88\uC774\uB098 \uC4F0\uB7EC\uC84C\uB2E4\uB2C8...
          \uBB34\uB9AC\uD558\uC9C0 \uB9D0\uACE0 \uD55C \uB9C8\uB9AC\uC529 \uC0C1\uB300\uD574\uBD10."
        choices:
        - choiceText: "\uC54C\uACA0\uC5B4, \uC870\uC2EC\uD560\uAC8C"
          nextNodeId: 
        - choiceText: "\uBB34\uAE30\uB97C \uBC14\uAFD4\uC57C \uD560\uAE4C?"
          nextNodeId: weapon
      - nodeId: weapon
        textTemplate: "\uBB34\uAE30\uBCF4\uB2E4 \uBA3C\uC800 \uAC70\uB9AC \uC870\uC808\uACFC
          \uD68C\uD53C \uD0C0\uC774\uBC0D\uBD80\uD130 \uC5F0\uC2B5\uD574\uBCF4\uB294
          \uAC8C \uB098\uC744 \uAC70\uC57C."
        choices: []
  - difficultyType: 2
    entries:
    - entryId: lost_1
      weight: 1
      nodes:
      - nodeId: start
        textTemplate: "\uD55C \uC790\uB9AC\uC5D0 \uACC4\uC18D \uBA38\uBB3C\uB7EC
