        - choiceText: "\uADF8\uB0E5 \uB458\uB7EC\uBCF4\uACE0 \uC788\uC5C8\uC5B4"
          nextNodeId: 
      - nodeId: quest_hint
        textTemplate: "\uD018\uC2A4\uD2B8 \uBAA9\uD45C\uB294 \uBCF4\uD1B5 \uD45C\uC2DC\uB41C
