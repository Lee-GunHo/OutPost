        - choiceText: "\uC54C\uC544\uC11C \uCC3E\uC544\uBCFC\uAC8C"
          nextNodeId: 
      - nodeId: map_hint
        textTemplate: "\uC778\uBCA4\uD1A0\uB9AC\uB098 \uBA54\uB274\uC5D0\uC11C \uC9C0\uB3C4\uB97C
          \uC5F4 \uC218 \uC788\uC744 \uAC70\uC57C. \uB9C9\uD788\uBA74 \uB098\uD55C\uD14C
